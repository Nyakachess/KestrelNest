---
import { cohortDisplayName, type Cohort } from '@nest/schema'
import EmptyCard from '../../../components/EmptyCard.astro'
import Legend from '../../../components/Legend.astro'
import PersonCard from '../../../components/PersonCard.astro'
import Base from '../../../layouts/Base.astro'
import { cohorts, SITE, summarize } from '../../../lib/data'
import { formatRange, plural } from '../../../lib/format'

export function getStaticPaths() {
  return cohorts.map((cohort) => ({ params: { id: cohort.id }, props: { cohort } }))
}

const { cohort } = Astro.props as { cohort: Cohort }
const s = summarize(cohort)
const name = cohortDisplayName(cohort.id)
const nav = [
  { href: '/cohorts/', label: 'Cohorts', current: true },
  { href: `${SITE.repoUrl}/blob/main/docs/roadmap.md`, label: 'Roadmap' },
]
const issues = `${SITE.repoUrl}/issues?q=label%3Acohort%3A${cohort.id}`
---

<Base title={`Cohort ${cohort.id} on Nest`} description={`The ${name}: published contributor pages and progress on the ladder.`} nav={nav}>
  <main id="main" class="section">
    <div class="wrap">
      <a href="/cohorts/" class="back-link"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M13 8H3m4-4-4 4 4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>All cohorts</a>
      <div class="row between end mt-4" style="gap: 20px">
        <div>
          <p class="label">Cohort {cohort.id}</p>
          <h1 class="h-page mt-2">{name}</h1>
          <p class="meta-line mt-2" style="color: var(--muted-fg)">{formatRange(cohort.starts, cohort.ends)} · {plural(cohort.members.length, 'member')} · {plural(s.published.length, 'page')} published</p>
        </div>
        <div class="row">
          <a href={issues} class="btn btn-secondary">Cohort issues <span class="arrow" aria-hidden="true">&#8599;</span></a>
          <a href={`${SITE.repoUrl}/blob/main/CHANGELOG.md`} class="btn btn-primary">v{SITE.release} changelog <span class="arrow" aria-hidden="true">&#8599;</span></a>
        </div>
      </div>
      <div class="hairline mt-4"></div>

      <div class="grid grid-4 mt-4">
        <div class="stat"><div class="k">Pages published</div><div class="v">{s.published.length}<small>of {cohort.members.length}</small></div><div class="s">each by its owner's choice</div></div>
        <div class="stat"><div class="k">Stages completed</div><div class="v">{s.stagesCompleted}</div><div class="s">across published pages</div></div>
        <div class="stat"><div class="k">Shared-code PRs</div><div class="v">{s.shared}</div><div class="s">merged by page owners</div></div>
        <div class="stat"><div class="k">External work</div><div class="v">{s.external}</div><div class="s">listed by their owners</div></div>
      </div>

      <div class="row between mt-5" style="margin-bottom: 16px">
        <p class="label">Members · published pages only</p>
        <Legend />
      </div>
      <div class="grid grid-3">
        {s.published.map((c) => <PersonCard contributor={c} />)}
        {s.unpublished > 0 && <EmptyCard title={`${plural(s.unpublished, 'member has', 'members have')} not published yet`}>Pages appear here when their owner chooses.</EmptyCard>}
        {s.published.length === 0 && s.unpublished === 0 && <EmptyCard title="No members yet." className="span-all">Members are listed in cohort.yml.</EmptyCard>}
      </div>
      <p class="muted mt-3">Counts come from merged pull requests and from what each owner lists. Live pages keep growing. No member is ranked.</p>
    </div>
  </main>
</Base>
