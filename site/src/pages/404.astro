---
import Base from '../layouts/Base.astro'
import { SITE } from '../lib/data'
---

<Base title="Page not found on Nest" description="This page does not exist on Nest.">
  <main id="main" class="section" style="padding-top: 64px; padding-bottom: 96px">
    <div class="wrap-narrow">
      <span class="eyebrow">404</span>
      <h1 class="mt-2" style="font-size: clamp(26px, 3vw, 34px)">There is no page here.</h1>
      <p class="ink2 mt-2" style="max-width: 56ch">
        Contributor pages live at <code>/p/handle/</code> and appear only once their owner publishes them. If you expected one here, it may still be private, or the handle may be spelt differently.
      </p>
      <div class="row mt-4">
        <a href="/" class="btn btn-primary">Home</a>
        <a href="/cohorts/" class="btn btn-secondary">Cohorts</a>
        <a href={SITE.repoUrl} class="btn btn-secondary">GitHub</a>
      </div>
    </div>
  </main>
</Base>
