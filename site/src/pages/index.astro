---
import EmptyCard from '../components/EmptyCard.astro'
import Ladder from '../components/Ladder.astro'
import PersonCard from '../components/PersonCard.astro'
import Base from '../layouts/Base.astro'
import { byActivity, cohorts, contributors, SITE } from '../lib/data'
import { plural } from '../lib/format'

const recent = byActivity(contributors).slice(0, 3)
const first = recent[0]
const learnerLink = first
  ? { href: `/p/${first.handle}/`, label: "See a learner's page", external: false }
  : { href: `${SITE.repoUrl}/tree/main/contributors/_example`, label: 'See the page template', external: true }
const stageOne = `${SITE.repoUrl}/issues?q=is%3Aopen+label%3Astage%3A1`
const description =
  "Nest is Kestrel Collective's open-source onboarding project. Every new contributor builds a portfolio page here through real pull requests, and it keeps growing with every verified contribution they make anywhere."
---

<Base title="Nest: a starter project that grows with you" description={description}>
  <main id="main">
    <section class="section">
      <div class="wrap grid-12 center">
        <div class="span-7">
          <span class="eyebrow-pill">A starter project that grows with you</span>
          <h1 class="display mt-3">Your first <span class="nowrap">open-source</span> contributions, in a codebase <span class="accent">built for them.</span></h1>
          <p class="lead mt-3" style="max-width: 56ch">
            Nest is a real, maintained open-source project. Every new Kestrel contributor gets a page here that they build themselves, pull request by pull request, and that keeps growing with every verified contribution they make anywhere.
          </p>
          <div class="row mt-4">
            <a href={stageOne} class="btn btn-accent btn-lg">Start with Stage 1 <span class="arrow" aria-hidden="true">&#8599;</span></a>
            <a href={learnerLink.href} class="btn btn-secondary btn-lg">{learnerLink.label} {learnerLink.external && <span class="arrow" aria-hidden="true">&#8599;</span>}</a>
          </div>
          <div class="hairline mt-4"></div>
          <div class="stats-row mt-3">
            <span><b>{contributors.length}</b>contributor {contributors.length === 1 ? 'page' : 'pages'}</span>
            <span><b>{cohorts.length}</b>{cohorts.length === 1 ? 'cohort' : 'cohorts'}</span>
            <span><b>v{SITE.release}</b>latest release</span>
          </div>
        </div>
        <div class="span-5">
          <div class="code-panel" aria-label="Example profile file">
            <div class="bar">
              <span class="dot" style="background: var(--accent)"></span><span class="dot" style="background: var(--brand)"></span><span class="dot" style="background: #6b8a8d"></span>
              <span class="file">contributors/your-login/profile.yml</span>
            </div>
            <div class="body">
              <div><span class="k">handle:</span> your-login</div>
              <div><span class="k">name:</span> Your Name</div>
              <div><span class="k">cohort:</span> <span class="hl">2027-01</span></div>
              <div><span class="k">skills_developing:</span></div>
              <div class="in">- debugging</div>
              <div class="in">- reading unfamiliar code</div>
              <div><span class="k">visibility:</span></div>
              <div class="in"><span class="k">page:</span> public</div>
            </div>
            <div class="ft"><span class="ok">&#10003; validate</span><span class="ok">&#10003; build</span><span class="live">preview deployed</span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="label">The ladder · an invitation, not a gate</p>
        <h2 class="h-statement mt-2">Seven stages, from first clone to your own proposal.</h2>
        <div class="ladder-card mt-4"><Ladder /></div>
        <p class="muted mt-3">Experienced already? Skip to Stage 5 or straight to the <a href={SITE.landingUrl}>Kestrel board</a>. Nothing here is required for anything else.</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="row between end">
          <div>
            <p class="label">{first ? `Recent pages · ${plural(contributors.length, 'page')}` : 'Pages'}</p>
            <h2 class="h-statement mt-2">Built by the people on them.</h2>
          </div>
          <a href="/cohorts/" class="more">All cohorts <span class="arrow" aria-hidden="true">&#8594;</span></a>
        </div>
        <div class="grid grid-3 mt-4">
          {
            first ? (
              recent.map((c) => <PersonCard contributor={c} />)
            ) : (
              <EmptyCard title="The first pages are being built right now." className="span-all">
                Pages appear here when their owners publish them. The project is open to clone now.
              </EmptyCard>
            )
          }
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap grid grid-3" style="gap: 28px">
        <div class="feature"><h3>A real project</h3><p>CI on every PR, previews, CODEOWNERS, ADRs, a public roadmap and quarterly releases. The same workflow you will meet everywhere else.</p></div>
        <div class="feature"><h3>Evidence, labelled honestly</h3><p>Pages separate practice in your own directory, contributions to Nest's shared code, and work accepted by other projects. Nothing is dressed up as more than it is.</p></div>
        <div class="feature"><h3>Yours, for good</h3><p>Publish what you choose, edit forever, unpublish with one PR. Your page keeps growing after onboarding ends, from verified work, wherever you do it.</p></div>
      </div>
    </section>
  </main>
</Base>
