---
import { initials, STAGE_COUNT, stagesDone, type Contributor } from '@nest/schema'
import Ladder from '../../../components/Ladder.astro'
import Base from '../../../layouts/Base.astro'
import { cohortOf, contributors, SITE } from '../../../lib/data'
import { formatDate, tone } from '../../../lib/format'
import { renderMarkdown } from '../../../lib/markdown'

export function getStaticPaths() {
  return contributors.map((c) => ({ params: { handle: c.handle }, props: { contributor: c } }))
}

const { contributor: c } = Astro.props as { contributor: Contributor }
const cohort = cohortOf(c)
const external = c.profile.projects.length
const shared = c.practice.shared
const practice = c.practice.practice
const done = stagesDone(c.practice)
const nav = cohort ? [{ href: `/cohorts/${cohort.id}/`, label: `Cohort ${cohort.id}` }] : [{ href: '/cohorts/', label: 'Cohorts' }]
const action = { href: `${SITE.repoUrl}/tree/main/contributors/${c.handle}`, label: 'Edit on GitHub' }
const mergedPrs = `${SITE.repoUrl}/pulls?q=is%3Apr+is%3Amerged+author%3A${c.handle}`
const meta = [`@${c.handle}`, c.profile.cohort ? `cohort ${c.profile.cohort}` : null, `joined ${formatDate(c.profile.joined)}`].filter(Boolean).join(' · ')
---

<Base title={`${c.profile.name} on Nest`} description={c.profile.intro} nav={nav} action={action} footerNote="This page is maintained by its owner. Counts come from merged pull requests.">
  <main id="main" class="section">
    <div class="wrap">
      <section class="grid-12">
        <div class="span-8 row start" style="gap: 24px">
          <div class="avatar avatar-lg" style={`background: ${tone(c.handle)}`} aria-hidden="true">{initials(c.profile.name)}</div>
          <div style="flex: 1; min-width: 240px">
            <h1 class="h-page">{c.profile.name}</h1>
            <p class="meta-line mt-2">{meta}</p>
            <p class="lead mt-3" style="max-width: 56ch">{c.profile.intro}</p>
            {c.profile.skills_developing.length > 0 && <div class="chips mt-3">{c.profile.skills_developing.map((s) => <span class="chip">{s}</span>)}</div>}
          </div>
        </div>
        <aside class="span-4 card">
          <p class="label">Counted separately</p>
          <div class="counts-list mt-3">
            <div class="counts-row"><span class="marker marker-external" aria-hidden="true"></span><span class="n">{external}</span><span>external {external === 1 ? 'contribution' : 'contributions'}</span><span class="src">listed by owner</span></div>
            <div class="counts-row"><span class="marker marker-shared" aria-hidden="true"></span><span class="n">{shared}</span><span>shared-project {shared === 1 ? 'contribution' : 'contributions'}</span><span class="src">merged in Nest</span></div>
            <div class="counts-row"><span class="marker marker-practice" aria-hidden="true"></span><span class="n">{practice}</span><span>practice {practice === 1 ? 'task' : 'tasks'}</span><span class="src">own directory</span></div>
          </div>
          {c.profile.next && (
            <div class="next-box mt-3">
              <p class="label label-accent" style="margin: 0">Next</p>
              <p>{c.profile.next}</p>
            </div>
          )}
        </aside>
      </section>

      <section class="mt-5">
        <p class="label">Onboarding ladder · {done} of {STAGE_COUNT}</p>
        <div class="ladder-card mt-3"><Ladder done={c.practice.stages_done} /></div>
      </section>

      <section class="grid-12 mt-5">
        <div class="span-7 sections">
          {c.page.sections.map((s) => (
            <div>
              <h2 class="h-statement" style="font-size: 26px">{s.title}</h2>
              <div class="prose" set:html={renderMarkdown(s.body)} />
            </div>
          ))}
        </div>
        <div class="span-5">
          <div class="card card-flush">
            <div class="card-head"><p class="label">What I contributed</p><span class="mono small muted">updated after merges</span></div>
            {c.profile.projects.map((p) => (
              <div class="evidence-row">
                <span class="marker marker-external" aria-hidden="true"></span>
                <div>
                  <div class="title">{p.title}</div>
                  <div class="meta">External · <a href={p.url}>{p.repo}</a> · merged {formatDate(p.merged)} · listed by owner</div>
                </div>
              </div>
            ))}
            {shared > 0 && (
              <div class="evidence-row">
                <span class="marker marker-shared" aria-hidden="true"></span>
                <div><div class="title">{shared} merged into shared code</div><div class="meta">Shared project · <a href={mergedPrs}>pull requests by @{c.handle}</a></div></div>
              </div>
            )}
            {practice > 0 && (
              <div class="evidence-row">
                <span class="marker marker-practice" aria-hidden="true"></span>
                <div><div class="title">{practice} merged on this page</div><div class="meta">Practice · pull requests in contributors/{c.handle}/</div></div>
              </div>
            )}
            {external + shared + practice === 0 && <div class="evidence-row"><div class="muted">Nothing merged yet. Counts appear after the first pull request lands.</div></div>}
            <div class="card-foot">Practice, shared-project and external work are counted separately and shown separately here. External work is listed by the owner. Verification through Kestrel records is not part of this release.</div>
          </div>
        </div>
      </section>
    </div>
  </main>
</Base>
