---
import { SITE } from '../lib/data'

type Props = {
  nav?: { href: string; label: string; current?: boolean }[] | undefined
  action?: { href: string; label: string } | undefined
}

const defaultNav = [
  { href: '/cohorts/', label: 'Cohorts' },
  { href: `${SITE.repoUrl}/blob/main/docs/roadmap.md`, label: 'Roadmap' },
  { href: `${SITE.repoUrl}/blob/main/docs/CONTRIBUTING.md`, label: 'Contributing' },
]
const nav = Astro.props.nav ?? defaultNav
const action = Astro.props.action ?? { href: SITE.repoUrl, label: 'GitHub' }
---

<header class="site-header">
  <div class="wrap">
    <a href="/" class="brand">Nest <small>by Kestrel Collective</small></a>
    <nav class="site-nav" aria-label="Site">
      {nav.map((item) => <a href={item.href} aria-current={item.current ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a href={action.href} class="btn btn-outline btn-sm">{action.label} &#8599;</a>
    </div>
    <details class="menu-toggle">
      <summary aria-label="Open menu">
        <svg aria-hidden="true" width="18" height="14" viewBox="0 0 18 14"><path d="M1 1h16M1 7h16M1 13h16" stroke="#0E5450" stroke-width="2"></path></svg>
      </summary>
      <div class="menu">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={action.href} class="btn btn-outline btn-sm">{action.label} &#8599;</a>
      </div>
    </details>
  </div>
</header>
