---
import { initials, pageUrl, stagesDone, STAGE_COUNT, type Contributor } from '@nest/schema'
import { SITE } from '../lib/data'
import { tone } from '../lib/format'
import Marker from './Marker.astro'

type Props = { contributor: Contributor }
const { contributor: c } = Astro.props
const external = c.profile.projects.length
const shared = c.practice.shared
const practice = c.practice.practice
const href = new URL(pageUrl(SITE.url, c.handle)).pathname
---

<a href={href} class="card card-link person-card" aria-label={`${c.profile.name}, contributor page`}>
  <div class="who">
    <div class="avatar" style={`background: ${tone(c.handle)}`} aria-hidden="true">{initials(c.profile.name)}</div>
    <div>
      <div class="name">{c.profile.name}</div>
      <div class="handle">@{c.handle}</div>
    </div>
  </div>
  <p class="intro">{c.profile.intro}</p>
  <div class="counts">
    {external > 0 && <Marker kind="external" count={external} />}
    {shared > 0 && <Marker kind="shared" count={shared} />}
    {practice > 0 && <Marker kind="practice" count={practice} />}
    {external + shared + practice === 0 && <span class="pill">Stage {stagesDone(c.practice)} of {STAGE_COUNT}</span>}
  </div>
</a>
