---
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/header.css'
import '../styles/ladder.css'
import '../styles/components.css'
import '../styles/components-2.css'
import SiteFooter from '../components/SiteFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import { SITE } from '../lib/data'

type Props = {
  title: string
  description: string
  nav?: { href: string; label: string; current?: boolean }[]
  action?: { href: string; label: string }
  footerNote?: string
}

const { title, description, nav, action, footerNote } = Astro.props
const canonical = new URL(Astro.url.pathname, SITE.url).href
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9f9" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico?v=6" sizes="any" />
    <link rel="icon" href="/kestrel-mark.png?v=6" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=6" />
    <link rel="alternate" type="application/json" href="/api/pages.json" title="Nest pages feed" />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=clash-display@500,600,700&f[]=satoshi@400,500,700&display=swap"
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <SiteHeader nav={nav} action={action} />
    <slot />
    <SiteFooter note={footerNote} />
  </body>
</html>
