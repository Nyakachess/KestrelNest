{
  "name": "kestrelnest",
  "version": "0.1.0",
  "private": true,
  "description": "Kestrel Collective's open-source onboarding project",
  "license": "MIT",
  "repository": "github:Nyakachess/KestrelNest",
  "homepage": "https://nest.kestrelcollective.org",
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "workspaces": [
    "packages/*",
    "site"
  ],
  "scripts": {
    "build": "tsc -b && npm run build -w site",
    "dev": "npm run dev -w site",
    "start": "npm run dev -w site",
    "preview": "npm run preview -w site",
    "test": "vitest run",
    "typecheck": "tsc -b --dry",
    "lint": "prettier --check . && node scripts/check-dashes.mjs",
    "format": "prettier --write .",
    "validate": "nest validate",
    "feed": "nest feed",
    "prepare": "tsc -b"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "vitest": "^3.2.0"
  }
}
